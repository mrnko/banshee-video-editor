{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Banshee Video Editor",
  "version": "0.1.3",
  "identifier": "com.banshee.videoeditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Banshee Video Editor",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 720,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#09070f"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "category": "Video",
    "shortDescription": "AI-assisted vertical video editor",
    "longDescription": "Local-first editor for finding, reviewing and rendering highlights for TikTok, Reels and Shorts.",
    "copyright": "Copyright 2026 Banshee contributors",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4NzQ5RUVDQzFDRDEzNEMKUldSTUU4M0I3SjUwT0RqWDJsSDRXVGpmalJ0a0I4bDBrbnJGWE5jNC9JK2JsZzlvTC9XZ2plSXYK",
      "endpoints": [
        "https://github.com/mrnko/banshee-video-editor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
